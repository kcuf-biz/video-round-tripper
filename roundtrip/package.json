{
  "name": "@kcuf.biz/video-round-tripper",
  "private": true,
  "version": "0.1.0",
  "description": "Round-trips a live web page through your device's video codec and paints the damage back on top.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kcuf-biz/video-round-tripper.git",
    "directory": "roundtrip"
  },
  "scripts": {
    "prepack": "node scripts/pack-exports.mjs apply",
    "postpack": "node scripts/pack-exports.mjs restore"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./core": {
        "types": "./dist/core/index.d.ts",
        "import": "./dist/core.js"
      },
      "./iife": "./dist/roundtrip.iife.js"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "^18.3.1 || ^19",
    "react-dom": "^18.3.1 || ^19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/dom-webcodecs": "^0.1.13",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5"
  }
}
