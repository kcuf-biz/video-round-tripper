{
  "name": "@kcuf.biz/video-round-tripper",
  "version": "0.1.1",
  "description": "Round-trips a live web page through your device's video codec and paints the damage back on top.",
  "license": "MIT",
  "homepage": "https://kcuf.biz/video-round-tripper/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kcuf-biz/video-round-tripper.git",
    "directory": "roundtrip"
  },
  "bugs": {
    "url": "https://github.com/kcuf-biz/video-round-tripper/issues"
  },
  "keywords": [
    "webcodecs",
    "video",
    "codec",
    "datamosh",
    "glitch",
    "compression-artifacts",
    "react"
  ],
  "scripts": {
    "prepublishOnly": "npm --prefix .. run build:lib",
    "prepack": "node scripts/pack-exports.mjs apply",
    "postpack": "node scripts/pack-exports.mjs restore"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts"
  },
  "distExports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core.js"
    },
    "./iife": "./dist/roundtrip.iife.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "^18.3.1 || ^19",
    "react-dom": "^18.3.1 || ^19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/dom-webcodecs": "^0.1.13",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5"
  }
}
